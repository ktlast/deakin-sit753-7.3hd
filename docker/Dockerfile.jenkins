FROM docker:29-cli AS dockercli
FROM jenkins/jenkins:lts-jdk21
USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl python3 rsync && rm -rf /var/lib/apt/lists/*
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
RUN jenkins-plugin-cli --plugins workflow-aggregator pipeline-stage-view junit credentials-binding timestamper
COPY docker/init.groovy /usr/share/jenkins/ref/init.groovy.d/sit753.groovy
USER jenkins
